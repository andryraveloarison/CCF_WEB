{
  "headers": [
    {
      "source": "/releases/:file",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ccf.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!releases/).*)",
      "destination": "/index.html"
    }
  ]
}
